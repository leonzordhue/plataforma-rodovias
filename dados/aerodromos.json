ular":27965,"faixa_baixa":13902,"faixa_alta":56251}},"pan":{"pax":{"2018":3100,"2019":3108,"2020":3116,"2021":3125,"2022":3133,"2023":3265,"2024":3400,"2025":3538,"2026":3680,"2027":3825,"2028":4006,"2029":4212,"2030":4431,"2031":4661,"2032":4905,"2033":5161,"2034":5430,"2035":5714,"2036":6013,"2037":6328,"2038":6659},"rede":"REGIONAL SECUNDÁRIO","porte":"Local"},"texto":["Lábrea fica no rio Purus e tem território de 68 mil km². A cidade tem ligação terrestre com Porto Velho em parte do ano, o que faz da ligação aérea uma alternativa e não a única saída. A pista 18/36 tem 1.200 m por 30 m em asfalto.","Em 2011 a prefeitura administrava o aeródromo, a TRIP voava quatro vezes por semana e um táxi aéreo outras cinco. O plano registrou terminal pequeno para a demanda, roçados dentro do sítio aeroportuário, pessoas e animais na área de movimento e um lixão a 1,4 km.","A queda do movimento é das mais nítidas da série. A ANAC registrou cerca de 10 mil passageiros por ano entre 2010 e 2012, 3 mil em 2016, 814 em 2022 e 207 em 2023. Em 2025 foram 675, em voos de pequeno porte para Manaus, Coari e Porto Velho. O plano estadual de 2011 previa perto de 19 mil passageiros em 2021."]},{"id":"SBMY","oaci":"SBMY","ciad":"AM0015","nome":"Aeroporto de Manicoré","municipio":"Manicoré","lat":-5.81111,"lon":-61.27833,"comp":1265,"larg":30,"desig":"05/23","resist":"12/F/C/Y/U","sup":"Asfalto","op_d":"VFR","op_n":"","alt":"53 m","situacao":"Cadastrado","validade":"01/12/2032","classe":"1","p2011":{"pista":"1.280 x 30","piso":"Asfalto","pcn":"12 F/C/Y/U","tps":250,"operacao":"VFR diurno"},"proj2011":{"2016":5021,"2021":5711,"2031":7590},"pax":{"2010":462,"2011":0,"2012":0,"2013":34,"2014":255,"2015":2324,"2016":0,"2017":0,"2018":0,"2019":0,"2020":0,"2021":44,"2022":76,"2023":2861,"2024":2244,"2025":2112},"mov":{"2010":{"reg":392,"nreg":70,"dec":33,"emp":["Rico"]},"2012":{"reg":0,"nreg":0,"dec":8,"emp":[]},"2013":{"reg":0,"nreg":34,"dec":2,"emp":["Map Transportes Aéreos"]},"2014":{"reg":0,"nreg":255,"dec":5,"emp":["Map Transportes Aéreos"]},"2015":{"reg":2065,"nreg":259,"dec":66,"emp":["Map Transportes Aéreos"]},"2021":{"reg":0,"nreg":44,"dec":1,"emp":["Map Transportes Aéreos"]},"2022":{"reg":76,"nreg":0,"dec":7,"emp":["Azul Conecta"]},"2023":{"reg":2824,"nreg":37,"dec":137,"emp":["Map Transportes Aéreos","Azul Conecta"]},"2024":{"reg":1156,"nreg":1088,"dec":204,"emp":["Azul Conecta","Apuí Táxi Aéreo"]},"2025":{"reg":2015,"nreg":97,"dec":197,"emp":["Apuí Táxi Aéreo","Azul Conecta"]}},"pop":58018,"base":2406,"potencial":4140,"projecao":{"2031":{"pop":62128,"oferta_atual":2576,"servico_regular":4783,"faixa_baixa":2378,"faixa_alta":9621},"2041":{"pop":69635,"oferta_atual":2887,"servico_regular":6085,"faixa_baixa":3025,"faixa_alta":12240}},"pan":{"pax":{},"rede":"REGIONAL SECUNDÁRIO","porte":"Local"},"texto":["Manicoré fica no rio Madeira, a pouco mais de 330 km de Manaus em linha reta, a meio caminho entre a capital e Porto Velho. É o maior produtor de melancia e banana do estado segundo o plano de 2011. A pista 05/23 tem 1.265 m por 30 m em asfalto e aparece no cadastro atual com PCR 90, valor alto para o porte do aeródromo.","O diagnóstico de 2011 elogiou o terminal recém-reformado e climatizado, mas apontou drenagem assoreada, cerca rompida, invasões na área patrimonial, carro contraincêndio em pane fora do sítio e presença de urubus perto da pista.","Depois de 2,3 mil passageiros em 2015, o aeródromo passou seis anos quase sem movimento comercial. A ligação voltou em 2023, com 2,9 mil passageiros, e se manteve em torno de 2 mil em 2024 e 2025, com voos para Manaus e para Apuí."]},{"id":"SWMW","oaci":"SWMW","ciad":"AM0020","nome":"Aeroporto de Maués","municipio":"Maués","lat":-3.37194,"lon":-57.72472,"comp":1200,"larg":30,"desig":"01/19","resist":"8/F/C/Y/U","sup":"Asfalto","op_d":"VFR","op_n":"Sem Operação","alt":"21 m","situacao":"Cadastrado","validade":"18/11/2032","classe":"1","p2011":{"pista":"1.200 x 30","piso":"Asfalto","pcn":"08 F/C/Y/U","tps"